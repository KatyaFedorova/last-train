#!/usr/bin/env bash
# Check the shared .cljc core runs as ClojureScript (nbb = SCI on Node, the
# interpreter Scittle uses in the browser) and matches Babashka exactly.
set -euo pipefail
cd "$(dirname "$0")/.."

script='
(require (quote [last-train.terminal :as t]) (quote [last-train.puzzles :as p]))
(doseq [{:keys [name]} p/catalog]
  (let [draw (fn [_] 0)
        s (reduce #(t/submit %1 %2 draw)
                  (t/boot {:puzzle-param name :rand-int draw})
                  ["hello" "help" "ASK B Is D the Agent?" "ask A, is C human?"
                   "accuse A" "new"])]
    (doseq [{:keys [text kind]} (:lines s)] (println kind text))))'

cljs=$(npx --yes nbb@1 -cp src -e "$script")
clj=$(bb -cp src -e "$script")

if [[ "$cljs" == "$clj" ]]; then
  echo "cljs-smoke: ClojureScript session matches Babashka ($(printf '%s\n' "$clj" | wc -l | tr -d ' ') lines, all puzzles)"
else
  echo "cljs-smoke: ClojureScript session differs from Babashka" >&2
  diff <(printf '%s\n' "$cljs") <(printf '%s\n' "$clj") >&2 || true
  exit 1
fi
