{:paths ["src" "adapter"]
 :deps {speclj/speclj {:mvn/version "3.13.0"}}
 :tasks
 {spec {:doc "Run unit specs"
        :extra-paths ["spec"]
        :requires ([speclj.main])
        :task (apply speclj.main/-main "-c" "spec" *command-line-args*)}
  property {:doc "Run property tests (test.check); kept out of spec, coverage and mutation"
            :extra-paths ["property"]
            :requires ([speclj.main])
            :task (apply speclj.main/-main "-c" "property" *command-line-args*)}
  hardening {:doc "Run focused hardening specifications"
             :extra-paths ["hardening"]
             :requires ([speclj.main])
             :task (apply speclj.main/-main "-c" "hardening" *command-line-args*)}
  acceptance-spec {:doc "Run specs for the acceptance runtime and generator"
                   :extra-paths ["acceptance/src" "acceptance/spec"]
                   :requires ([speclj.main])
                   :task (apply speclj.main/-main "-c" "acceptance/spec" *command-line-args*)}
  acceptance-generate {:doc "acceptance-entrypoint-generator <json-ir> <generated-test-output>"
                       :extra-paths ["acceptance/src"]
                       :requires ([last-train.acceptance.generator])
                       :task (apply last-train.acceptance.generator/-main *command-line-args*)}
  acceptance-run {:doc "Run generated acceptance tests"
                  :extra-paths ["acceptance/src" "acceptance/generated"]
                  :requires ([speclj.main])
                  :task (apply speclj.main/-main "-c" "acceptance/generated" *command-line-args*)}
  acceptance-runner-worker {:doc "Persistent gherkin-mutator runner adapter (JSON lines on stdin/stdout)"
                            :extra-paths ["acceptance/src"]
                            :requires ([last-train.acceptance.runner-worker])
                            :task (last-train.acceptance.runner-worker/-main)}
  site {:doc "Build the static site into build/site/"
        :requires ([last-train.site])
        :task (last-train.site/build!)}
  serve {:doc "Build and serve the site locally: bb serve [--port N]"
         :requires ([last-train.site])
         :task (apply last-train.site/-main *command-line-args*)}
  acceptance {:doc "Parse features, generate entry points, run acceptance tests"
              :task (shell "bin/acceptance")}}}
